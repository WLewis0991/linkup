# Secret used to sign/verify JWTs. Generate with: openssl rand -base64 32
JWT_SECRET=

# Pooled connection (Supavisor). Used by the app at runtime.
DATABASE_URL=

# Direct connection (no pooler). Used by Prisma migrations and db seed.
DIRECT_URL=

# Port the API listens on. Render injects this automatically.
PORT=3000

# Deployed client origin, e.g. https://linkup.vercel.app
# Used for CORS and Socket.IO. Must be set in production.
# Comma-separated list is allowed (handy locally for multiple Vite ports).
FRONTEND_URL=http://localhost:5173
